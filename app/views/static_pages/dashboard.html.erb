<% if logged_in? %>
  <% condenser_ok = @dashboard_rows.first&.dig(:condenser_available) %>

  <style>
    /* Let the dashboard use the screen width instead of Bulma's capped container. */
    .dashboard-section {
      padding-right: 1rem;
      padding-left: 1rem;
    }

    .dashboard-section > .container.dashboard-container {
      width: 100%;
      max-width: none;
      padding-right: 0;
      padding-left: 0;
    }

    /* Narrow windows scroll the table rather than wrapping every website row. */
    .dashboard-table-scroll {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
    }

    .table.dashboard-table {
      width: 100%;
      table-layout: auto;
    }

    .table.dashboard-table th,
    .table.dashboard-table td {
      padding: 0.35rem 0.6rem;
      vertical-align: middle;
      white-space: nowrap;
    }

    .dashboard-site,
    .dashboard-actions {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      white-space: nowrap;
    }

    .dashboard-site .icon {
      width: 1.1rem;
      height: 1.1rem;
    }

    .dashboard-site .tag,
    .dashboard-table td > .tag {
      height: 1.5em;
    }

    .dashboard-actions {
      display: flex;
      justify-content: flex-end;
    }

    .dashboard-actions .button {
      height: 1.8rem;
      margin: 0;
      padding: 0.2rem 0.5rem;
    }
  </style>

  <section class="section dashboard-section pb-3">
    <div class="container is-fluid dashboard-container">
      <!-- Page identity -->
      <div class="level mb-4">
        <div class="level-left">
          <div>
            <h1 class="title mb-1">
              <%= t('.your_website').pluralize(@websites.count) %>
            </h1>
            <p class="subtitle is-6 has-text-grey">
              <%= current_user.name %>
            </p>
          </div>
        </div>

        <div class="level-right">
          <label class="checkbox">
            <input type="checkbox" id="toggle-pipeline">
            Show pipeline diagnostics
          </label>
        </div>
      </div>

      <% unless condenser_ok %>
        <div class="notification is-warning is-light mb-4">
          <strong>Condenser service unavailable.</strong>
          Some dashboard metrics may be incomplete.
        </div>
      <% end %>

      <!-- Dashboard explanation and website setup -->
      <div class="box mb-4">
        <div class="level mb-3">
          <div class="level-left">
            <h2 class="title is-5 mb-0">Dashboard</h2>
          </div>
          <div class="level-right">
            <%= link_to "Add website", first_scrape_websites_path, class: "button is-primary" %>
          </div>
        </div>

        <p class="content is-small has-text-grey mb-0">
          <strong>Data as of</strong>
          <% if @dashboard_data_as_of %>
            <% stamp = @dashboard_data_as_of.in_time_zone %>
            <%= time_tag(stamp, stamp.strftime("%b %-d, %Y %H:%M %Z"),
                  title: "Oldest available Condenser snapshot time. Individual refreshes may be older.") %>
          <% else %>
            <span>unavailable</span>
          <% end %>
          <% if Rails.env.staging? %> · Staging<% end %>
        </p>
      </div>
    </div>
  </section>

  <section class="section dashboard-section pt-0">
    <div class="container is-fluid dashboard-container">
      <% if @dashboard_rows.present? %>
        <div class="dashboard-table-scroll" role="region" aria-label="Website dashboard" tabindex="0">
          <table class="table dashboard-table is-striped is-hoverable is-fullwidth">
            <thead>
              <!-- Group headings match the columns below. -->
              <tr class="dashboard-groups">
                <th colspan="4" scope="colgroup" class="group-website">Website</th>
                <th colspan="3" scope="colgroup" class="group-quality">Content Quality</th>
                <th colspan="3" scope="colgroup" class="group-scheduling">Scheduling</th>
                <th scope="col" class="group-pipeline pipeline-column">Pipeline</th>
                <th scope="col" class="is-hidden-mobile"></th>
              </tr>
              <tr>
                <th scope="col"><%= dashboard_sort_link("website", t(:website)) %></th>
                <th scope="col"><%= dashboard_sort_link("webpages", "Event pages") %></th>
                <th scope="col"><%= dashboard_sort_link("statements", "Statements") %></th>
                <th scope="col" class="is-hidden-mobile" title="Statements refreshed / updated in the last 24 hours">24h activity</th>
                <th scope="col"><%= dashboard_sort_link("flags", t(:flags)) %></th>
                <th scope="col"><%= dashboard_sort_link("updates", t(:updates)) %></th>
                <th scope="col"><%= dashboard_sort_link("publishable", "% Publishable", title: "Publishable event pages divided by all event pages") %></th>
                <th scope="col"><%= dashboard_sort_link("overdue", "Overdue", title: "Time beyond the monitored ResourceList refresh or import deadline, rounded up to days") %></th>
                <th scope="col"><%= dashboard_sort_link("horizon", "Archive horizon", title: "Days until the latest Event webpage archive date in this snapshot") %></th>
                <th scope="col"><%= dashboard_sort_link("inventory_age", "Inventory freshness", title: "Sort by age of the newest event webpage") %></th>
                <th scope="col" class="pipeline-column">Pipeline</th>
                <th scope="col" class="is-hidden-mobile"></th>
              </tr>
            </thead>

            <tbody>
              <% @dashboard_rows.each do |row| %>
                <% condenser_available = row[:condenser_available] %>
                <% website = row[:website] %>
                <% condenser_stats = row[:condenser] %>
                <% metrics = row[:metrics] %>
                <% event_count = condenser_stats["event_pages"] %>
                <% publishable = condenser_stats["publishable_event_percentage"] %>

                <tr>
                  <td>
                    <div class="dashboard-site">
                      <%= link_to display_website_url(website.url), events_path(seedurl: website.url), title: display_website_url(website.url) %>

                      <% if metrics[:pipeline_warning] %>
                        <span class="icon has-text-warning"
                              title="No new events discovered for <%= metrics[:days_since_last_webpage_label] %>">
                          ⚠️
                        </span>
                      <% elsif metrics[:total_webpages] == 0 %>
                        <span class="tag is-warning is-light" title="No events currently detected for this website">
                          ⚠️ 0
                        </span>
                      <% end %>
                    </div>
                  </td>

                  <td class="has-text-right"><%= event_count.nil? ? "—" : number_with_delimiter(event_count) %></td>
                  <td class="has-text-right"><%= condenser_stats["statements_grouped"] %></td>

                  <td class="is-hidden-mobile">
                    <% if condenser_available %>
                      <span title="Statements refreshed / updated in the last 24 hours">
                        <%= condenser_stats["statements_refreshed_24hr"] %> / <%= condenser_stats["statements_updated_24hr"] %>
                      </span>
                    <% else %>
                      —
                    <% end %>
                  </td>

                  <td class="has-text-right"><%= condenser_available ? condenser_stats["flags"] : "—" %></td>
                  <td class="has-text-right"><%= condenser_available ? condenser_stats["updates"] : "—" %></td>

                  <td>
                    <% if !condenser_available || publishable.nil? %>
                      —
                    <% else %>
                      <% tone = publishable >= 95 ? "success" : (publishable >= 85 ? "warning" : "danger") %>
                      <span class="has-text-<%= tone %>" title="<%= condenser_stats["publishable_event_pages"] %> of <%= event_count %> event pages publishable">
                        <%= number_to_percentage(publishable, precision: 1, strip_insignificant_zeros: true) %>
                      </span>
                    <% end %>
                  </td>

                  <td class="dashboard-overdue">
                    <% risk = metrics[:schedule_risk_level] if condenser_available %>
                    <% if risk == :ok %>
                      <span class="tag is-success is-light">On time</span>
                    <% elsif %i[warning critical].include?(risk) %>
                      <span class="tag <%= risk == :critical ? "is-danger" : "is-warning" %> is-light"><%= metrics[:days_overdue] %>d late</span>
                    <% else %>
                      <span title="No conclusive scheduled ResourceList completion evidence">—</span>
                    <% end %>
                  </td>

                  <td><%= metrics[:event_horizon_label] || "—" %></td>

                  <td class="dashboard-inventory">
                    <%= render "inventory_freshness", inventory: condenser_stats["inventory_freshness"],
                      fallback_age: metrics[:days_since_last_webpage_label] %>
                  </td>

                  <!-- Detailed diagnostics run only when this link is opened. -->
                  <td class="pipeline-column">
                    <% if website.monitorable? %>
                      <%= link_to "Check", pipeline_website_path(website), title: "Check pipeline for #{display_website_url(website.url)}" %>
                    <% else %>
                      —
                    <% end %>
                  </td>

                  <td class="is-hidden-mobile">
                    <div class="dashboard-actions">
                      <%= link_to "Settings", edit_website_path(website), class: "button is-info is-small" %>
                      <% if current_user.admin? %>
                        <%= link_to "delete", website, method: :delete,
                                    data: { confirm: "You sure?" }, class: "button is-danger is-small" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>
<% else %>
  <div class="container">
    <div class="hero">
      <div class="hero-body has-text-centered">
        <%= render 'about_blurb' %>
        <br>
        <br>
        <% if public_signup_enabled? %>
          <%= link_to "Join", signup_path, class: "button is-primary is-large" %>
          <p class="mt-4">Already a member? <%= link_to "Login", login_path %></p>
        <% else %>
          <%= link_to "Login", login_path, class: "button is-primary is-large" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
