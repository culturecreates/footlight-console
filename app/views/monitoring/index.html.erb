<section class="section">
  <div class="container is-fluid">
    <h1 class="title">Monitoring</h1>
    <p class="mb-4">Flagged DSL errors and problems from enrolled preprocessing policies. Each issue resolves when its own condition recovers. Optional email digests and the weekly pulse summarize these same open issues.</p>
    <% if @monitoring_error %>
      <div class="notification is-warning"><%= @monitoring_error %> <%= link_to "Retry", monitoring_path(seedurl: @seedurl, status: @status, page: @page) %></div>
    <% else %>
      <%= form_with url: monitoring_path, method: :get, local: true do %>
        <%= label_tag :seedurl, "Site" %>
        <%= select_tag :seedurl, options_for_select([["All sites", "all"]] + @feed["sites"].map { |site| [site, site] }, @seedurl) %>
        <%= label_tag :status, "Status" %>
        <%= select_tag :status, options_for_select([["Open", "open"], ["Resolved", "resolved"], ["All", "all"]], @status) %>
        <%= submit_tag "Filter", class: "button is-small" %>
      <% end %>
      <p class="my-3"><strong><%= @feed.dig("pagination", "total_entries") %></strong> issues · 100 per page</p>
      <div class="table-container">
        <table class="table is-fullwidth is-striped">
          <thead><tr><th>Site / property</th><th>Error</th><th>Last seen</th><th>Occurrences</th><th>Status</th><th>Inspect</th></tr></thead>
          <tbody>
            <% @feed["issues"].each do |issue| %>
              <tr>
                <td><strong><%= issue["website_name"].presence || issue["seedurl"] %></strong><br><%= issue["property_name"] %><br><%= (issue["kind"].presence || "dsl_error").to_s.humanize %></td>
                <td><%= issue["message"] %></td><td><span title="First seen: <%= issue["first_seen_at"] %>"><%= issue["last_seen_at"] %></span></td><td><%= issue["occurrences"] %></td>
                <td><span class="tag <%= issue["resolved_at"].present? ? 'is-success' : 'is-danger' %>"><%= issue["resolved_at"].present? ? "Resolved" : "Open" %></span></td>
                <td>
                  <%= link_to "Source", "#{Condenser::API.base_url}/sources/#{issue['source_id'].to_i}" %>
                  <% if issue["statement_id"].present? %> · <%= link_to "Statement", "#{Condenser::API.base_url}/statements/#{issue['statement_id'].to_i}" %><% end %>
                  <% if issue["preprocessing_policy_id"].present? %> · <%= link_to "Policy", "#{Condenser::API.base_url}/preprocessing_policies/#{issue['preprocessing_policy_id'].to_i}/edit" %><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @feed["issues"].empty? %><p>No monitored issues match these filters.</p><% end %>
      <nav class="level" aria-label="Monitoring pages">
        <% if @page > 1 %><%= link_to "Previous", monitoring_path(seedurl: @seedurl, status: @status, page: @page - 1) %><% end %>
        <% if @page < @feed.dig("pagination", "total_pages") %><%= link_to "Next", monitoring_path(seedurl: @seedurl, status: @status, page: @page + 1) %><% end %>
      </nav>
    <% end %>
  </div>
</section>
