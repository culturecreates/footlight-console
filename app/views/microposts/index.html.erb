<section>
  <div class="container">

    <% timeline = cookies[:timeline] || "upcoming" %>

    <% if @microposts.any? %>

      <h1 class="title">
        <%= pluralize(@microposts.count, "Comment") %>
        for <%= timeline == "upcoming" ? "upcoming events" : "past events" %>
      </h1>

      <h2 class="subtitle">
        <%= @seedurl %>
      </h2>

      <ol class="microposts">
        <%= render 'microposts/micropost_details', microposts: @microposts %>
      </ol>

    <% else %>

      <div class="has-text-centered">
        <h1 class="title">
          No comments for <%= timeline == "upcoming" ? "upcoming events" : "past events" %>
        </h1>

        <h2 class="subtitle">
          <%= @seedurl %>
        </h2>
      </div>

    <% end %>

  </div>
</section>