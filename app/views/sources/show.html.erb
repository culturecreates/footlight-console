<section class="section pt-5">

  <!-- Header -->
  <div class="container">

    <div class="level mb-5">
      <div class="level-left">
        <div>
          <h1 class="title is-3 mb-1">
            <%= @events.count %>
            <%= "Upcoming " if cookies[:timeline] == "upcoming" %>
            Events
          </h1>
          <p class="subtitle is-6 has-text-grey">
            Structured knowledge extracted from source
          </p>
        </div>
      </div>

      <div class="level-right">
        <%= link_to "Review All",
              source_path(params[:id], seedurl: @seedurl),
              method: :patch,
              class: "button is-primary is-medium is-rounded use-loading" %>
      </div>
    </div>

    <!-- Timeline toggle -->
    <div class="mb-5">
      <%= render partial: "timeline",
            locals: {
              url_upcoming: source_path(params[:id], timeline: "upcoming"),
              url_all: source_path(params[:id], timeline: "all")
            } %>
    </div>

  </div>

  <!-- Events -->
  <% props = @property_labels.drop(1).reject { |p| p.to_s.strip.downcase == "title" } %>
  <div class="container">

    <div class="table-container">
      <table class="table is-fullwidth is-striped is-hoverable is-size-7 source-table">

      <thead>
        <tr>
          <th style="width: 25%">Title</th>
          <% props.each do |p| %>
            <th><%= p.humanize %></th>
          <% end %>
          <th style="width: 60px">⚠</th>
          <th style="width: 100px"></th>
        </tr>
      </thead>

      <tbody>

        <% @events.each do |uri, statements| %>

          <% title =
              statements["title_fr"]&.dig("value") ||
              statements["title_en"]&.dig("value") %>

          <% event_health = compute_event_health(statements, {}, timeline: cookies[:timeline] || :upcoming) %>

          <tr>

            <!-- Title column -->
            <td>
              <%= link_to display_statement(title, "raw"),
                          event_path(uri),
                          class: "has-text-weight-semibold has-text-link-dark" %>

              <% if statements.first[1]["subject"] %>
                <div class="has-text-grey-light is-size-7">
                  <%= statements.first[1]["subject"].split("#{@seedurl}_")[1] %>
                </div>
              <% end %>
            </td>

            <!-- Property columns -->
            <% props.each do |p| %>
              <td>
                <% [:fr, :en, nil].each do |lang| %>
                  <% key = make_key(p, lang&.to_s) %>
                  <% st = statements[key] %>
                  <% next unless st %>

                  <% value = st.is_a?(Hash) ? st["value"] : st %>

                  <div class="source-cell">
                    <%= display_statement(value, "raw") %>

                    <% if event_health[:properties][key] %>
                      <% ph = event_health[:properties][key] %>

                      <% if ph[:severity] == :critical %>
                        <span class="tag is-danger is-light is-small ml-1">!</span>
                      <% elsif ph[:severity] == :warning %>
                        <span class="tag is-warning is-light is-small ml-1">⚠</span>
                      <% end %>
                    <% end %>
                  </div>

                <% end %>
              </td>
            <% end %>

            <!-- Event severity column -->
            <td class="has-text-centered">
              <% case event_health[:event_severity] %>
              <% when :critical %>
                <span class="tag is-danger">Problem</span>
              <% when :warning %>
                <span class="tag is-warning">Check</span>
              <% else %>
                <span class="tag is-success">OK</span>
              <% end %>
            </td>

          </tr>

        <% end %>

      </tbody>

      </table>
    </div>

    <!-- Bottom CTA -->
    <div class="has-text-centered mt-5">
      <%= link_to "Review All",
            source_path(params[:id], seedurl: @seedurl),
            method: :patch,
            class: "button is-primary is-medium is-rounded use-loading" %>
    </div>

  </div>

</section>